# URL base da API do backend (NestJS). Copie este arquivo para .env.local
# e ajuste a porta se o backend estiver rodando localmente em :3000,
# já que o Next dev server também usa :3000 por padrão (rode o Next com
# `next dev -p 3001`, por exemplo, ou aponte NEXT_PUBLIC_API_URL para a
# porta real do backend).
NEXT_PUBLIC_API_URL=http://localhost:3001/api
